{
  "name": "vailbox",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "setup": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/setup-bin.ps1",
    "setup:geo": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/setup-bin.ps1 -GeoOnly",
    "app": "node scripts/with-cargo.mjs tauri dev",
    "app:build": "node scripts/with-cargo.mjs tauri build --bundles nsis",
    "test": "node scripts/with-cargo.mjs cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-autostart": "^2.0.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
