{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VeilBox",
  "version": "2.2.0",
  "identifier": "com.vailbox.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VeilBox",
        "width": 420,
        "height": 860,
        "minWidth": 380,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": [
      "bin/*"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCNUUzNzI1RTJBMUU0NTUKUldSVjVLSGlKVGRldS9na0RoTnRXTndXbFFsRkdaeFFmZ3Q5c0F3dzN2WXJLcGNubnQ1bFprYkEK",
      "endpoints": [
        "https://github.com/Slowmoney/VeilBox/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
